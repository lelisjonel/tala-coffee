---
// Illustrated cup used in place of product photos.
interface Props {
  liquid: string;
  foam?: string;
  steam?: boolean;
  iced?: boolean;
  class?: string;
}

const { liquid, foam, steam = false, iced = false, class: className } = Astro.props;
---

<svg class:list={['cup_component', className]} viewBox="0 0 200 200" role="img" aria-hidden="true">
  {steam && (
    <g class="cup_steam" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity="0.35">
      <path d="M82 52c-8-10 8-16 0-28" />
      <path d="M100 48c-8-10 8-16 0-28" />
      <path d="M118 52c-8-10 8-16 0-28" />
    </g>
  )}
  {iced ? (
    <g>
      <path d="M58 62h84l-10 118a8 8 0 0 1-8 7H76a8 8 0 0 1-8-7z" fill="#fffdf9" fill-opacity="0.55" stroke="#2b1d16" stroke-opacity="0.15" stroke-width="2" />
      <path d="M62 92h76l-7.6 88a6 6 0 0 1-6 5H75.6a6 6 0 0 1-6-5z" fill={liquid} />
      <rect x="78" y="98" width="20" height="20" rx="4" fill="#fffdf9" fill-opacity="0.5" transform="rotate(-12 88 108)" />
      <rect x="104" y="110" width="18" height="18" rx="4" fill="#fffdf9" fill-opacity="0.45" transform="rotate(10 113 119)" />
      {foam && <path d="M62 92h76l-1.2 14H63.2z" fill={foam} />}
      <rect x="112" y="30" width="6" height="80" rx="3" fill="#c8823e" transform="rotate(12 115 70)" />
    </g>
  ) : (
    <g>
      <ellipse cx="100" cy="176" rx="72" ry="10" fill="#2b1d16" opacity="0.1" />
      <path d="M140 98h10a22 22 0 0 1 0 44h-12" fill="none" stroke="#fffdf9" stroke-width="10" />
      <path d="M46 84h108v40a54 54 0 0 1-108 0z" fill="#fffdf9" />
      <ellipse cx="100" cy="84" rx="54" ry="12" fill={liquid} />
      {foam && <ellipse cx="100" cy="84" rx="40" ry="8" fill={foam} />}
      {foam && <path d="M100 79c-6 0-9 3-9 5s4 4 9 0 9 0 9-1-3-4-9-4z" fill={liquid} opacity="0.6" />}
      <ellipse cx="100" cy="84" rx="54" ry="12" fill="none" stroke="#2b1d16" stroke-opacity="0.12" stroke-width="2" />
    </g>
  )}
</svg>

<style>
  .cup_component {
    width: 100%;
    height: auto;
    color: var(--color-espresso);
  }
  .cup_steam path {
    animation: steam 3.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: bottom;
  }
  .cup_steam path:nth-child(2) { animation-delay: 0.6s; }
  .cup_steam path:nth-child(3) { animation-delay: 1.2s; }
  @keyframes steam {
    0%, 100% { opacity: 0; transform: translateY(6px) scaleY(0.9); }
    40% { opacity: 1; }
    80% { opacity: 0; transform: translateY(-8px) scaleY(1.05); }
  }
</style>
